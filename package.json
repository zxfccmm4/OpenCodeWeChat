{
  "name": "opencode-wechat",
  "version": "0.3.0",
  "description": "Turn WeChat into a mobile gateway for local OpenCode and OMO via the official ClawBot ilink API",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "bun setup.ts",
    "start": "bun index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "package:current": "bun scripts/package-app.ts",
    "package:mac": "bun scripts/package-app.ts --target macos-arm64 --target macos-x64",
    "package:win": "bun scripts/package-app.ts --target windows-x64",
    "package:all": "bun scripts/package-app.ts --target macos-arm64 --target macos-x64 --target windows-x64"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/bun": "latest",
    "@types/qrcode-terminal": "^0.12.2",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/sdk": "^1.2.27"
  }
}
