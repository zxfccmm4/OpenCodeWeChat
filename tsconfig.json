{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["*.ts", "api/*.ts", "core/*.ts", "login/*.ts", "mcp/*.ts", "polling/*.ts", "scripts/*.ts", "storage/*.ts", "types/*.ts"],
  "exclude": ["node_modules", "dist", "claude-code-wechat-channel"]
}
